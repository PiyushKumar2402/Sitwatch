# Copy to .env to override the defaults used by docker-compose.yml
MYSQL_DATABASE=sitewatch
MYSQL_USER=sitewatch
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too
APP_PORT=8080
TZ=Asia/Kolkata
# true only for the local demo (lets SiteWatch monitor the demo-site container). Use false anywhere public.
SITEWATCH_ALLOW_PRIVATE_HOSTS=true
